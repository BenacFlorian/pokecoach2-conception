# Local stack — copy to `.env` and set passwords locally.
# POSTGRES_* initialize a new volume only; changing .env does not rename DB or reset an existing volume.

POSTGRES_DB=pokecoach2
POSTGRES_USER=pokecoach_admin
POSTGRES_PASSWORD=
POSTGRES_PORT=5442

API_DB_PASSWORD=
WORKER_DB_PASSWORD=

# Plan 3 — optional services
POSTGRAPHILE_PORT=4042
ANGULAR_PORT=8082
POSTGRAPHILE_BUILD_CONTEXT=../../../pokecoach2-postgraphile

# Image pins (update digest after verification)
POSTGRES_IMAGE=postgres:17.4-bookworm
FLYWAY_BUILD_CONTEXT=../..
